{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "topic_key",
    "story",
    "evidence"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "topic_key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "slug",
        "project_key",
        "tr",
        "en"
      ],
      "properties": {
        "type": {
          "enum": [
            "article",
            "case_study"
          ]
        },
        "slug": {
          "type": "string"
        },
        "project_key": {
          "const": "monafy"
        },
        "sort_order": {
          "type": "integer"
        },
        "case_meta": {
          "type": "object"
        },
        "tr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "excerpt",
            "content",
            "meta_title",
            "meta_description"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "excerpt": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "meta_title": {
              "type": "string"
            },
            "meta_description": {
              "type": "string"
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 255
            }
          }
        },
        "en": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "excerpt",
            "content",
            "meta_title",
            "meta_description"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "excerpt": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "meta_title": {
              "type": "string"
            },
            "meta_description": {
              "type": "string"
            },
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 255
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "sources"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "repository",
                "commit",
                "path"
              ],
              "properties": {
                "repository": {
                  "type": "string"
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "path": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
